{
	"$schema": "https://opencode.ai/config.json",
	"agent": {
		"build": {
			"permission": {
				"bash": {
					"$HOME/.claude/skills/qmd-knowledge/scripts/record.sh": "allow",
					"$HOME/.config/opencode/skills/qmd-knowledge/scripts/record.sh": "allow",
					"git push": "ask",
					"qmd": "allow",
					"qmd get": "allow",
					"qmd query": "allow",
					"qmd search": "allow"
				}
			}
		},
		"explorer": {
			"description": "Fast explorer subagent for codebase exploration",
			"mode": "subagent",
			"model": "omniroute/free"
		}
	},
	"default_agent": "plan",
	"formatter": {
		"biome": {
			"command": ["biome", "check", "--write", "$FILE"],
			"extensions": [".ts", ".tsx", ".js", ".jsx"]
		},
		"gofmt": {
			"command": ["gofmt", "-w", "$FILE"],
			"extensions": [".go"]
		},
		"prettier": {
			"command": ["npx", "prettier", "--write", "$FILE"],
			"extensions": [".md", ".mdx"]
		},
		"ruff": {
			"command": ["ruff", "format", "$FILE"],
			"extensions": [".py"]
		},
		"rustfmt": {
			"command": ["rustfmt", "$FILE"],
			"extensions": [".rs"]
		},
		"shfmt": {
			"command": ["shfmt", "-w", "$FILE"],
			"extensions": [".sh"]
		},
		"stylua": {
			"command": ["stylua", "$FILE"],
			"extensions": [".lua"]
		}
	},
	"mcp": {
		"agentmemory": {
			"command": ["npx", "-y", "@agentmemory/mcp"],
			"enabled": true,
			"environment": {
				"AGENTMEMORY_SECRET": "${AGENTMEMORY_SECRET:-}",
				"AGENTMEMORY_TOOLS": "${AGENTMEMORY_TOOLS:-all}",
				"AGENTMEMORY_URL": "${AGENTMEMORY_URL:-http://localhost:3111}"
			},
			"type": "local"
		},
		"context7": {
			"command": ["npx", "-y", "@upstash/context7-mcp@latest"],
			"enabled": true,
			"type": "local"
		},
		"fff": {
			"command": ["fff-mcp"],
			"enabled": true,
			"type": "local"
		},
		"logpilot": {
			"command": ["logpilot", "mcp-server"],
			"enabled": true,
			"type": "local"
		},
		"qmd": {
			"command": ["qmd", "mcp"],
			"enabled": true,
			"type": "local"
		},
		"react-grab-mcp": {
			"command": ["npx", "-y", "@react-grab/mcp", "--stdio"],
			"enabled": true,
			"type": "local"
		},
		"sem": {
			"command": ["sem-mcp"],
			"enabled": true,
			"type": "local"
		},
		"sequential-thinking": {
			"command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
			"enabled": true,
			"type": "local"
		},
		"ctx": {
			"command": ["ctx", "mcp", "serve"],
			"enabled": true,
			"type": "local"
		},
		"codebase-memory-mcp": {
			"enabled": true,
			"type": "local",
			"command": ["codebase-memory-mcp"]
		}
	},
	"model": "omniroute/free",
	"plugin": ["@plannotator/opencode@latest", "opencode-chrome-annotation@latest"],
	"provider": {
		"omniroute": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "OmniRoute",
			"options": {
				"baseURL": "http://localhost:20128/v1",
				"apiKey": "sk_omniroute"
			},
			"models": {
				"paid": {
					"name": "paid",
					"modalities": {
						"input": ["text", "image"],
						"output": ["text"]
					}
				},
				"free": {
					"name": "free",
					"modalities": {
						"input": ["text", "image"],
						"output": ["text"]
					}
				},
				"premium": {
					"name": "premium",
					"modalities": {
						"input": ["text", "image"],
						"output": ["text"]
					}
				},
				"kc/openrouter/free": {
					"name": "kc/openrouter/free"
				},
				"oc/deepseek-v4-flash-free": {
					"name": "oc/deepseek-v4-flash-free"
				},
				"cu/auto": {
					"name": "cu/auto"
				},
				"cmd/deepseek/deepseek-v4-pro": {
					"name": "cmd/deepseek/deepseek-v4-pro"
				},
				"cmd/deepseek/deepseek-v4-flash": {
					"name": "cmd/deepseek/deepseek-v4-flash"
				},
				"cp/cline-pass/deepseek-v4-pro": {
					"name": "cp/cline-pass/deepseek-v4-pro"
				},
				"cp/cline-pass/deepseek-v4-flash": {
					"name": "cp/cline-pass/deepseek-v4-flash"
				}
			}
		}
	}
}
