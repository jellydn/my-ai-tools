		"omniroute": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "OmniRoute",
			"options": {
				"baseURL": "http://localhost:20128/v1",
				"apiKey": "sk_omniroute"
			},
			"models": {
				"paid": {
					"name": "paid",
					"modalities": {
						"input": ["text", "image"],
						"output": ["text"]
					}
				},
				"free": {
					"name": "free",
					"modalities": {
