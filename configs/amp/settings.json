{
	"amp.dangerouslyAllowAll": true,
	"amp.experimental.autoHandoff": {
		"context": 90
	},
	"amp.mcpServers": {
		"context7": {
			"url": "https://mcp.context7.com/mcp"
		},
		"sequential-thinking": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
		},
		"qmd": {
			"command": "qmd",
			"args": ["mcp"]
		},
		"fff": {
			"command": "fff-mcp",
			"args": []
		},
		"react-grab-mcp": {
			"command": "npx",
			"args": ["-y", "@react-grab/mcp", "--stdio"]
		},
		"logpilot": {
			"command": "logpilot",
			"args": ["mcp-server"]
		},
		"agentmemory": {
			"command": "npx",
			"args": ["-y", "@agentmemory/mcp"]
		},
		"sem": {
			"command": "sem-mcp",
			"args": []
		},
		"ctx": {
			"command": "ctx",
			"args": ["mcp", "serve"]
		},
		"codebase-memory-mcp": {
			"command": "codebase-memory-mcp",
			"args": []
		}
	},
	"amp.terminal.theme": "cobalt",
	"amp.terminal.customThemes": {
		"cobalt": {
			"background": "#193549",
			"foreground": "#E1EFFF",
			"black": "#122738",
			"red": "#FF628C",
			"green": "#3AD900",
			"yellow": "#FFC600",
			"blue": "#0088FF",
			"magenta": "#CF7DFF",
			"cyan": "#00E5FF",
			"white": "#E1EFFF",
			"brightBlack": "#5C7685",
			"brightRed": "#FF0088",
			"brightGreen": "#2AFFDF",
			"brightYellow": "#FFC600",
			"brightBlue": "#5DA9FF",
			"brightMagenta": "#FF9D00",
			"brightCyan": "#80FCFF",
			"brightWhite": "#FFFFFF"
		}
	},
	"amp.gauge": "cost"
}
