            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${ORCA_PANE_KEY-}\" ] && [ -f "$HOME/.orca/agent-hooks/grok-hook.sh" ] && [ -r "$HOME/.orca/agent-hooks/grok-hook.sh" ] && [ -x "$HOME/.orca/agent-hooks/grok-hook.sh" ]; then /bin/sh "$HOME/.orca/agent-hooks/grok-hook.sh"; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
