{
	"name": "my-ai-tools",
	"version": "1.0.0",
	"type": "module",
	"bin": {
		"code-taste": "./scripts/code-taste.ts"
	},
	"workspaces": [
		"packages/*"
	],
	"engines": {
		"bun": ">=1.0.0"
	},
	"scripts": {
		"code-taste": "bun scripts/code-taste.ts",
		"test": "bun test",
		"index": "tsx scripts/index-repo.ts",
		"index:browser": "tsx scripts/index-browser.ts",
		"dev": "tsx server.ts",
		"bot:dev": "tsx --watch server.ts",
		"start": "tsx server.ts",
		"eval:retrieval": "tsx scripts/evaluate-retrieval.ts",
		"test:rag": "tsx --test tests/rag-indexer.test.ts",
		"test:code-taste": "bun test tests/code-taste.test.ts",
		"typecheck": "bun node_modules/typescript/lib/tsc.js --noEmit",
		"build:packages": "npm run build --workspaces --if-present",
		"test:packages": "npm test --workspaces --if-present",
		"link:user-memory": "npm run build --workspace @jellydn/user-memory-mcp && npm link --workspace @jellydn/user-memory-mcp",
		"test:user-memory": "npm test --workspace @jellydn/user-memory-mcp"
	},
	"dependencies": {
		"@hono/node-server": "^2.0.8",
		"@huggingface/transformers": "^4.2.0",
		"@vscode/tree-sitter-wasm": "0.3.1",
		"hono": "^4.6.3",
		"onnxruntime-node": "^1.27.0",
		"openai": "^7.0.0",
		"tsx": "^4.23.0",
		"web-tree-sitter": "0.27.1",
		"yaml": "^2.9.0",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"bun-types": "^1.1.29",
		"marked": "^18.1.0",
		"typescript": "^7.0.0"
	}
}
